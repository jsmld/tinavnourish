---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalPath?: string;
  /** Hide the global header/footer (rarely useful, e.g. print views). */
  bare?: boolean;
}

const { title, description, image, canonicalPath, bare = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      canonicalPath={canonicalPath}
    />
  </head>
  <body class="flex min-h-screen flex-col">
    {
      !bare && (
        <Header />
      )
    }
    <main class="flex-1">
      <slot />
    </main>
    {
      !bare && (
        <Footer />
      )
    }
  </body>
</html>
