---
import BaseLayout from '../layouts/BaseLayout.astro';
import RecipeCard from '../components/RecipeCard.astro';
import { getFeaturedRecipes, getAllRecipes } from '../lib/recipes';
import { COURSES, COURSE_LABELS, type Course } from '../lib/constants';

const featured = await getFeaturedRecipes(6);
const all = await getAllRecipes();

// "Browse by course" — list each course that has at least one recipe.
const coursesWithCounts = COURSES.map((c) => ({
  slug: c as Course,
  label: COURSE_LABELS[c],
  count: all.filter((r) => r.data.course === c).length,
  hero: all.find((r) => r.data.course === c)?.data.heroImage,
})).filter((c) => c.count > 0);
---

<BaseLayout
  title="tinavnourish"
  description="A warm editorial recipe journal — seasonal, plant-forward, occasionally fudgy."
>
  <!-- Hero -->
  <section class="mx-auto max-w-6xl px-6 pt-16 pb-10">
    <p class="text-xs uppercase tracking-[0.25em] text-terracotta">Recipe journal</p>
    <h1 class="mt-4 max-w-3xl font-serif text-5xl font-semibold leading-[1.05] text-ink sm:text-6xl">
      Recipes worth reading twice.
    </h1>
    <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink-soft">
      Slow, seasonal, plant-forward cooking with a sweet tooth. Each recipe comes with a
      headnote, a real ingredients list, and notes on what to change when you don't have
      the "right" pan.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="/recipes"
        class="rounded-full bg-ink px-6 py-3 text-sm font-semibold text-cream transition-colors hover:bg-ink-soft"
      >
        Browse all recipes
      </a>
      <a
        href="/recipes/course/baking"
        class="rounded-full bg-paper px-6 py-3 text-sm font-semibold text-ink ring-1 ring-rule transition-colors hover:ring-terracotta/40"
      >
        Start with baking
      </a>
    </div>
  </section>

  <!-- Featured -->
  <section class="mx-auto max-w-6xl px-6 py-12">
    <div class="mb-8 flex items-end justify-between gap-4">
      <div>
        <p class="text-xs uppercase tracking-[0.25em] text-terracotta">Editor's pick</p>
        <h2 class="mt-2 font-serif text-3xl font-semibold text-ink">Featured this month</h2>
      </div>
      <a
        href="/recipes"
        class="link-underline text-sm font-medium text-ink-soft hover:text-ink"
      >
        See all →
      </a>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {featured.map((recipe) => <RecipeCard recipe={recipe} />)}
    </div>
  </section>

  <!-- Browse by course -->
  {
    coursesWithCounts.length > 0 && (
      <section class="mx-auto max-w-6xl px-6 py-12">
        <p class="text-xs uppercase tracking-[0.25em] text-terracotta">Find your lane</p>
        <h2 class="mt-2 font-serif text-3xl font-semibold text-ink">Browse by course</h2>

        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {coursesWithCounts.map((c) => (
            <a
              href={`/recipes/course/${c.slug}`}
              class="group relative overflow-hidden rounded-2xl ring-1 ring-rule transition-all hover:-translate-y-0.5 hover:shadow-lg"
            >
              {c.hero && (
                <img
                  src={c.hero}
                  alt={c.label}
                  loading="lazy"
                  class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              )}
              <div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-ink/20 to-transparent" />
              <div class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-2 p-4">
                <p class="font-serif text-xl font-semibold text-cream">{c.label}</p>
                <span class="rounded-full bg-paper/90 px-2 py-0.5 text-xs font-medium text-ink">
                  {c.count} {c.count === 1 ? 'recipe' : 'recipes'}
                </span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
