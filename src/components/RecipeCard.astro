---
import type { Recipe } from '../lib/recipes';
import DietBadge from './DietBadge.astro';

interface Props {
  recipe: Recipe;
  /** Smaller, denser variant for related-recipes grids. */
  compact?: boolean;
}

const { recipe, compact = false } = Astro.props;
const { title, heroImage, author, diet, course } = recipe.data;
const href = `/recipes/${recipe.id}`;
---

<article
  class:list={[
    'group relative flex flex-col overflow-hidden rounded-2xl bg-paper ring-1 ring-rule transition-all hover:-translate-y-0.5 hover:shadow-lg hover:ring-terracotta/30',
    compact ? 'gap-3' : 'gap-4',
  ]}
>
  <a href={href} class="block overflow-hidden">
    <img
      src={heroImage}
      alt={title}
      loading="lazy"
      decoding="async"
      class:list={[
        'w-full object-cover transition-transform duration-500 group-hover:scale-105',
        compact ? 'aspect-[4/3]' : 'aspect-[5/4]',
      ]}
    />
  </a>

  <div class="flex flex-1 flex-col gap-2 px-5 pb-5">
    <div class="flex items-center gap-2 text-[0.7rem] uppercase tracking-[0.15em] text-ink-soft">
      <span>{course}</span>
      {
        diet.length > 0 && (
          <span class="flex flex-wrap gap-1">
            {diet.map((d) => (
              <DietBadge diet={d} />
            ))}
          </span>
        )
      }
    </div>

    <h3
      class:list={[
        'font-serif font-semibold leading-snug text-ink',
        compact ? 'text-lg' : 'text-xl',
      ]}
    >
      <a href={href} class="transition-colors hover:text-terracotta">
        {title}
      </a>
    </h3>

    <p class="mt-auto text-xs text-ink-soft">
      Recipe by <span class="font-medium text-ink">{author.name}</span>
    </p>
  </div>
</article>
