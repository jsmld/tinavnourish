---
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/recipes', label: 'Recipes' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
  // Reserved: shop is scaffolded for the future store.
  // { href: '/shop', label: 'Shop' },
];

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="border-b border-rule bg-cream/80 backdrop-blur sticky top-0 z-30">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-4">
    <a href="/" class="group flex items-baseline gap-2">
      <span
        class="font-serif text-2xl font-semibold tracking-tight text-ink transition-colors group-hover:text-terracotta"
      >
        tinavnourish
      </span>
      <span class="hidden text-xs uppercase tracking-[0.2em] text-ink-soft sm:inline">
        recipe journal
      </span>
    </a>

    <nav aria-label="Primary" class="flex items-center gap-1 sm:gap-2">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'rounded-full px-3 py-1.5 text-sm font-medium transition-colors',
              isActive(item.href)
                ? 'bg-ink text-cream'
                : 'text-ink-soft hover:bg-cream-deep hover:text-ink',
            ]}
          >
            {item.label}
          </a>
        ))
      }

      {/* Reserved cart-icon slot — wire when the store launches.
          <CartIcon /> */}
    </nav>
  </div>
</header>
